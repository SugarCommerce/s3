{
  "name": "sugarcommerce/s3",
  "description": "S3-compatible object storage for WordPress, with no SDK: SigV4 signing and presigned links for R2, S3, B2 and a dozen more providers, a bucket client that lists, copies and deletes, resumable checksummed multipart uploads to 5 TB, s3:// addresses, CORS rules, and a connection test that names the field to fix.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/SugarCommerce/s3",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/network": "dev-main",
    "sugarcommerce/plugin": "dev-main",
    "sugarcommerce/storage": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../network",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../storage",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SugarCommerce\\S3\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/SugarCommerce/s3/issues",
    "source": "https://github.com/SugarCommerce/s3"
  },
  "keywords": [
    "wordpress",
    "s3",
    "sigv4",
    "presigned-url",
    "cloudflare-r2",
    "object-storage",
    "multipart-upload",
    "cors",
    "backblaze-b2",
    "minio"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\S3\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
